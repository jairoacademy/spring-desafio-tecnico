meta {
  name: sistema-b lista
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/requests?customerId={{customerId}}&size=100
  body: none
  auth: oauth2
}

auth:oauth2 {
  grant_type: client_credentials
  access_token_url: {{tokenUrl}}
  client_id: sistema-b
  client_secret: dev
  scope: activation:read activation:write
  credentials_placement: body
  credentials_id: sistema-b
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}

tests {
  test("200 sem a solicitação de sistema-a", function() {
    expect(res.status).to.equal(200);
    const ids = res.body.content.map(r => r.id);
    expect(ids).to.not.include(bru.getVar("ownedRequestId"));
  });
}

docs {
  Mesmo `customerId` usado por `sistema-a`, mas a listagem traz só solicitações de
  `sistema-b` (e `totalElements` conta só essas). Compare com `03 Listar / Por cliente`,
  que roda como `sistema-a`.
}
