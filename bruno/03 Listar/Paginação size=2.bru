meta {
  name: Paginação size=2
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/requests?customerId={{customerId}}&page=0&size=2
  body: none
  auth: none
}

tests {
  test("no máximo 2 itens e metadados", function() {
    expect(res.status).to.equal(200);
    expect(res.body.content.length).to.be.at.most(2);
    expect(res.body.page).to.equal(0);
    expect(res.body.size).to.equal(2);
    expect(res.body.totalPages).to.equal(Math.ceil(res.body.totalElements / 2));
  });
}

docs {
  Crie 3 ou mais solicitações antes. Veja `totalElements` e `totalPages`.
  **Experimente:** `page=1` para a segunda página. Sem `page`/`size`, o padrão é 0 e 20.
}
