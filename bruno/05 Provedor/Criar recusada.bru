meta {
  name: Criar recusada
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/requests
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "externalId": "{{rejectedExternalId}}",
    "customerId": "{{customerId}}",
    "productCode": "INTERNET-500"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("rejectedRequestId", res.body.id);
  }
}

tests {
  test("201 PENDING mesmo com o provedor recusando", function() {
    expect(res.status).to.equal(201);
    expect(res.body.status).to.equal("PENDING");
    expect(res.body.failureReason).to.equal(null);
  });
}

docs {
  A criação não chama o provedor: responde `201` `PENDING` na hora, qualquer que seja o
  retorno dele. O envio acontece depois, no worker.
}
