meta {
  name: Sem customerId
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/requests
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "externalId": "EXT-1",
    "productCode": "INTERNET-500"
  }
}

tests {
  test("400 em ProblemDetail com traceId", function() {
    expect(res.status).to.equal(400);
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.body.type).to.equal("https://problems.ativacao.example/validation-error");
    expect(res.body.title).to.equal("Dados inválidos");
    expect(res.body.traceId).to.match(/^[0-9a-f]{32}$/);
  });

  test("errors cita customerId", function() {
    const fields = res.body.errors.map(e => e.field);
    expect(fields).to.include("customerId");
  });
}

docs {
  Campo obrigatório ausente. Veja a lista `errors`: cada item tem `field` (nome no JSON) e
  `message` (motivo em português, vindo do `message` da anotação no record).
}
