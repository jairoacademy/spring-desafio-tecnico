meta {
  name: externalId com 65 caracteres
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/requests
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "externalId": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "customerId": "CUST-1",
    "productCode": "INTERNET-500"
  }
}

tests {
  test("400 em ProblemDetail com traceId", function() {
    expect(res.status).to.equal(400);
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.body.type).to.equal("https://problems.ativacao.example/validation-error");
    expect(res.body.title).to.equal("Dados inválidos");
    expect(res.body.traceId).to.match(/^[0-9a-f]{32}$/);
  });

  test("errors cita externalId", function() {
    const fields = res.body.errors.map(e => e.field);
    expect(fields).to.include("externalId");
  });
}

docs {
  Limite é 64. A mensagem é específica de tamanho porque `@Size` é separado do `@Pattern`.
  **Experimente:** tire um `A` (64 caracteres) e veja virar 201.
}
