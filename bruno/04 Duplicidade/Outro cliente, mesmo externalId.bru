meta {
  name: Outro cliente, mesmo externalId
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/requests
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "externalId": "{{externalId}}",
    "customerId": "CUST-OUTRO",
    "productCode": "INTERNET-500"
  }
}

tests {
  test("409 com conflictingFields só com customerId", function() {
    expect(res.status).to.equal(409);
    expect(res.body.conflictingFields).to.deep.equal(["customerId"]);
  });
}

docs {
  A unicidade é global, não por `customerId`, como diz o enunciado: outro `customerId` com o
  mesmo `externalId` também é duplicidade. A alternativa por origem está no ADR 0001.

  Aqui o sistema chamador é o mesmo (`sistema-a`), então o `409` traz `conflictingFields`.
  Se o `externalId` fosse de outro sistema chamador, o `409` viria sem detalhes (ADR 0004).
}
